<mxfile host="vsdx-kit-example">
  <diagram name="网络拓扑" id="net">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="办公网络拓扑 Office network" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="inet" value="互联网&lt;br&gt;Internet" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fw" value="防火墙 Firewall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="270" y="245" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lan" value="内网 LAN 10.0.0.0/24" style="swimlane;startSize=30;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="100" width="520" height="380" as="geometry" />
        </mxCell>
        <mxCell id="sw" value="核心交换机" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lan">
          <mxGeometry x="30" y="145" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="srv" value="文件服务器" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lan">
          <mxGeometry x="350" y="50" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pc" value="办公电脑 ×40" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lan">
          <mxGeometry x="350" y="150" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ap" value="无线 AP" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lan">
          <mxGeometry x="350" y="250" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="WAN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="inet" target="fw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="fw" target="sw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="1 Gbps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;entryX=0;entryY=0.5;" edge="1" parent="1" source="sw" target="srv">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="275" />
              <mxPoint x="720" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="sw" target="pc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="Wi-Fi 6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;dashed=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="sw" target="ap">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="275" />
              <mxPoint x="720" y="395" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
